<style>
  :root {
    --ink: #1a2332;
    --muted: #64748b;
    --line: #e2e8f0;
    --bg: #f6f8fb;
    --card: #ffffff;
    --accent: #2f5fef;
    --accent-dark: #1e3fb8;

    --good-bg: #e3f8ec;
    --good-text: #0f7a3f;
    --good-border: #a6e6c3;

    --near-bg: #fff6e0;
    --near-text: #96650a;
    --near-border: #ffe1a3;

    --bad-bg: #fdeaea;
    --bad-text: #b3261e;
    --bad-border: #f6c1bd;
  }

  * { box-sizing: border-box; }

  body {
    margin: 0;
    font-family: 'Segoe UI', Roboto, -apple-system, BlinkMacSystemFont, sans-serif;
    background: var(--bg);
    color: var(--ink);
  }

  .app { max-width: 1180px; margin: 0 auto; padding: 20px 24px 60px; }

  .topbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
    margin-bottom: 20px;
  }

  .brand { display: flex; align-items: center; gap: 12px; }

  .brand-mark {
    width: 40px; height: 40px;
    border-radius: 10px;
    background: linear-gradient(135deg, var(--accent), var(--accent-dark));
    color: white;
    display: flex; align-items: center; justify-content: center;
    font-weight: 700; font-size: 18px;
  }

  h1 { margin: 0; font-size: 19px; }
  .subtitle { margin: 2px 0 0; font-size: 12.5px; color: var(--muted); }

  .view-toggle { display: flex; gap: 4px; background: #eef1f7; padding: 4px; border-radius: 10px; }

  .tab-btn {
    border: none; background: transparent; padding: 8px 16px;
    border-radius: 8px; font-size: 13.5px; font-weight: 600;
    color: var(--muted); cursor: pointer; transition: all .15s;
  }
  .tab-btn.active { background: var(--card); color: var(--accent); box-shadow: 0 1px 3px rgba(0,0,0,.08); }

  .filters {
    display: flex; flex-wrap: wrap; align-items: end; gap: 14px;
    background: var(--card); border: 1px solid var(--line);
    border-radius: 12px; padding: 14px 16px; margin-bottom: 22px;
  }

  .filter-group { display: flex; flex-direction: column; gap: 4px; min-width: 140px; }
  .filter-group label { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; color: var(--muted); }

  select {
    padding: 8px 10px; border-radius: 8px; border: 1px solid var(--line);
    font-size: 13.5px; background: white; color: var(--ink);
  }

  .apply-btn {
    background: var(--accent); color: white; border: none;
    padding: 9px 20px; border-radius: 8px; font-weight: 600;
    font-size: 13.5px; cursor: pointer;
  }
  .apply-btn:hover { background: var(--accent-dark); }

  .loading { font-size: 12.5px; color: var(--muted); }
  .hidden { display: none !important; }

  .card {
    background: var(--card); border: 1px solid var(--line);
    border-radius: 12px; padding: 18px 20px; margin-bottom: 20px;
  }
  .card h2 { margin: 0 0 14px; font-size: 15px; }

  .report-table { width: 100%; border-collapse: collapse; font-size: 13px; }
  .report-table th {
    text-align: left; padding: 8px 10px; font-size: 11px;
    text-transform: uppercase; letter-spacing: .03em; color: var(--muted);
    border-bottom: 2px solid var(--line);
  }
  .report-table td { padding: 9px 10px; border-bottom: 1px solid var(--line); }
  .report-table tbody tr:hover { background: #fafbfe; }
  .report-table tfoot td { font-weight: 700; border-top: 2px solid var(--line); border-bottom: none; }

  .badge {
    display: inline-block; padding: 3px 10px; border-radius: 999px;
    font-size: 12.5px; font-weight: 700; border: 1px solid transparent;
  }
  .badge.good  { background: var(--good-bg); color: var(--good-text); border-color: var(--good-border); }
  .badge.near  { background: var(--near-bg); color: var(--near-text); border-color: var(--near-border); }
  .badge.bad   { background: var(--bad-bg);  color: var(--bad-text);  border-color: var(--bad-border); }

  .row-good  { box-shadow: inset 3px 0 0 var(--good-text); }
  .row-near  { box-shadow: inset 3px 0 0 var(--near-text); }
  .row-bad   { box-shadow: inset 3px 0 0 var(--bad-text); }

  .kpi-card { text-align: center; }
  .kpi-value { font-size: 40px; font-weight: 800; color: var(--accent); }
  .kpi-caption { color: var(--muted); font-size: 12.5px; margin: 4px 0 0; }

  .foot { text-align: center; color: var(--muted); font-size: 11.5px; margin-top: 10px; }
  .foot a { color: var(--accent); text-decoration: none; }
  .foot a:hover { text-decoration: underline; }
  .foot-sep { margin: 0 6px; }

  .empty-row td { color: var(--muted); font-style: italic; text-align: center; padding: 18px; }

  @media (max-width: 720px) {
    .topbar { flex-direction: column; align-items: flex-start; }
    .report-table { display: block; overflow-x: auto; white-space: nowrap; }
  }
</style>
